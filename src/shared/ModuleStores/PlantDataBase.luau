function PlantDataBase:GetRequiredExp(plantId, currentLevel)
	local plantData = self.Database[plantId]
	if not plantData then
		return nil
	end

	local calculatedExp = plantData.baseExp * math.pow(currentLevel, plantData.expExponent)
	return math.floor(calculatedExp)
end

return PlantDataBase
